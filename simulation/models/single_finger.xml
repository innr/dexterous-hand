<mujoco model="single_finger">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.15" armature="0.01"/>
    <geom type="capsule" size="0.009" rgba="0.25 0.55 0.9 1" density="700"/>
    <position kp="12" kv="1.2" ctrllimited="true"/>
  </default>

  <worldbody>
    <light pos="0 -0.4 0.5" dir="0 0.5 -1"/>
    <geom name="floor" type="plane" size="0.5 0.5 0.02" rgba="0.18 0.18 0.2 1"/>
    <body name="palm" pos="0 0 0.08">
      <geom type="box" size="0.04 0.025 0.015" rgba="0.3 0.3 0.33 1"/>
      <body name="metacarpal" pos="0 0 0.015">
        <joint name="j0_abduction" axis="0 0 1" range="-0.4 0.4"/>
        <geom fromto="0 0 0 0 0 0.04"/>
        <body name="proximal" pos="0 0 0.04">
          <joint name="j1_mcp" axis="0 1 0" range="-0.1 1.3"/>
          <geom fromto="0 0 0 0 0 0.045"/>
          <body name="middle" pos="0 0 0.045">
            <joint name="j2_pip" axis="0 1 0" range="0 1.4"/>
            <geom fromto="0 0 0 0 0 0.03"/>
            <body name="distal" pos="0 0 0.03">
              <joint name="j3_dip" axis="0 1 0" range="0 1.1"/>
              <geom fromto="0 0 0 0 0 0.025"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="a0" joint="j0_abduction" ctrlrange="-0.4 0.4"/>
    <position name="a1" joint="j1_mcp" ctrlrange="-0.1 1.3"/>
    <position name="a2" joint="j2_pip" ctrlrange="0 1.4"/>
    <position name="a3" joint="j3_dip" ctrlrange="0 1.1"/>
  </actuator>
</mujoco>

